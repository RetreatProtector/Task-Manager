# Базовый образ — Node.js 20 на Alpine Linux (лёгкий, ~50 МБ)
FROM node:20-alpine

# Рабочая директория внутри контейнера
WORKDIR /app

# Сначала копируем только package.json и package-lock.json
# Это нужно для кэширования: если зависимости не менялись, Docker не будет их переустанавливать
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install --production

# Теперь копируем весь остальной код
COPY . .

# Открываем порт 3000 (документация, реально порт открывается при запуске)
EXPOSE 3000

# Команда, которая выполнится при старте контейнера
CMD ["node", "server.js"]
